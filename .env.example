# Copy to .env for local work; set these for real in production.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://paulfrendach.com
SITE_DOMAIN=paulfrendach.com
SITE_URL=http://127.0.0.1:8000
TIME_ZONE=America/New_York

# Mail. Without EMAIL_LIVE=1 everything prints to the console.
EMAIL_LIVE=0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=alex@findthe90.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=hello@paulfrendach.com

# ---------------------------------------------------------------- The LAB
# The Train room is a wrapper over The LAB's public API. Both values below come
# from the COACH, not from us: they issue the key themselves in The LAB under
# Settings -> API keys, and can revoke it without telling anybody here.
#
# Local dev: run scripts/seed_lab_dev.py and it writes both of these for you.
# Production: LAB_API_BASE=https://thelabplatform.com
LAB_API_BASE=http://127.0.0.1:8011
# lab_test_… while building. A test key's leads are flagged as tests, so the
# first six junk submissions do not land in the coach's real inbox.
LAB_API_KEY=
# Services and the intake form are read on nearly every Train page view and
# change when the coach edits them, which is rarely.
LAB_CACHE_SECONDS=120
LAB_TIMEOUT=10

# ---------------------------------------------------------------- Printful
# Get your API key from the Printful dashboard: Settings → API.
# Leave blank to disable the shop (pages will degrade gracefully).
PRINTFUL_API_KEY=
# Optional: set a random secret and register it in Printful's webhook settings
# to verify inbound webhook signatures.
PRINTFUL_WEBHOOK_SECRET=
# How long to cache Printful API responses (seconds). Default 900 = 15 min.
PRINTFUL_CACHE_SECONDS=900

# ---------------------------------------------------------------- Stripe (OMV)
# Oasis Media Visions bookings → Paul's own Stripe account. Use TEST keys here
# (Stripe Dashboard → test mode → Developers → API keys). With these blank the
# "Book — pay deposit" buttons stay hidden and the page falls back to a quote.
# For the webhook locally: `stripe listen --forward-to
# localhost:8012/create/stripe/webhook/` prints the whsec_… to paste below.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Where OMV commission + payment notices go (its own inbox, not the house one).
OMV_NOTIFY_EMAIL=paul@oasismediavisions.com

# ---------------------------------------------------------------- FindThe90 production domain
# Current live subdomain: ft90.pfrendach.com → pfrendach8.pythonanywhere.com (CNAME already set)
# Set these in PA environment panel, not here, for production.
# DJANGO_ALLOWED_HOSTS=ft90.pfrendach.com,pfrendach8.pythonanywhere.com,findthe90.com,www.findthe90.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ft90.pfrendach.com,https://findthe90.com,https://www.findthe90.com
# SITE_DOMAIN=ft90.pfrendach.com
# SITE_URL=https://ft90.pfrendach.com
