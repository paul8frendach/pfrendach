# Production .env for PythonAnywhere. Copy to /home/pfrendach8/paulfrendach/.env
# Nothing in here is committed - this file is the shape, not the secrets.

DJANGO_DEBUG=false
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=REPLACE_ME

# The apex is Paul's own site. ft90 and every future client preview live on
# their own subdomain, so the leading dot covers them without another entry.
DJANGO_ALLOWED_HOSTS=pfrendach.com,www.pfrendach.com,pfrendach8.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://pfrendach.com,https://www.pfrendach.com

SITE_DOMAIN=pfrendach.com
SITE_URL=https://pfrendach.com
TIME_ZONE=America/New_York

# PythonAnywhere terminates TLS at their proxy, so Django must not also try to
# redirect - it sees http and would loop forever.
SECURE_SSL_REDIRECT=false

# HSTS. Start SHORT. The default in settings.py is a year with
# includeSubDomains, and on the APEX that reaches ft90.pfrendach.com and every
# preview subdomain you create later. A year is not undoable from your end -
# browsers that saw it keep enforcing it. Raise this once the apex has served
# HTTPS happily for a few days.
SECURE_HSTS_SECONDS=300

# --- mail --------------------------------------------------------------------
# Until this is true, every message is printed to the server log and the
# contact form silently tells nobody.
EMAIL_LIVE=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=hello@pfrendach.com
NOTIFY_EMAIL=hello@pfrendach.com

# --- The LAB -----------------------------------------------------------------
# Paul's own coach account. Settings -> API keys on thelabplatform.com.
# The www is REQUIRED: the apex answers 301 and a redirect is where an
# Authorization header goes missing.
LAB_API_BASE=https://www.thelabplatform.com
LAB_API_KEY=REPLACE_ME
LAB_CACHE_SECONDS=120

# TRUE here, and only here. The guard exists to stop a laptop writing into a
# real coach's account; production is the case it was built to allow. With it
# false the enquiry form renders and then refuses to send, which is worse than
# not having the form.
LAB_ALLOW_LIVE_WRITES=true
